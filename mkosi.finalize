#!/usr/bin/env bash
# Runs at the end of the mkosi build with the assembled rootfs at $BUILDROOT.
# Measures the image, logs a breakdown of the heavy directories, and fails the
# build if it exceeds the size budget (Phase 1 hard gate, spec §5).
set -euo pipefail

BUDGET_MB="${PHASE1_SIZE_BUDGET_MB:-500}"
ROOT="${BUILDROOT:?BUILDROOT not set}"

used_bytes=$(du -sb "${ROOT}" | cut -f1)
used_mb=$(( used_bytes / 1024 / 1024 ))

echo "[finalize] rootfs size: ${used_mb} MB (budget ${BUDGET_MB} MB)"
echo "[finalize] heaviest paths:"
du -sh "${ROOT}/opt/astromesh" "${ROOT}/usr/lib/modules" "${ROOT}/usr/lib" \
       "${ROOT}/usr/bin" "${ROOT}/usr/share" 2>/dev/null | sort -rh | head -10 || true
echo "[finalize] venv site-packages top dirs:"
du -sh "${ROOT}"/opt/astromesh/venv/lib/python*/site-packages/* 2>/dev/null \
    | sort -rh | head -15 || true

if [ "${used_mb}" -gt "${BUDGET_MB}" ]; then
    echo "[finalize] OVER BUDGET by $(( used_mb - BUDGET_MB )) MB"
    exit 1
fi
echo "[finalize] within budget (${used_mb}/${BUDGET_MB} MB)"

# Fase 3.1: break-glass credential. mkosi applies RootPassword=hashed:! AFTER the postinst
# script, so the provisioned hash must be set HERE (finalize runs last) or it gets clobbered
# back to '!'. With getty masked and SSH absent, this hash is checkable only via sulogin at
# the console. Empty -> root stays locked (break-glass disabled, fail-closed). Edit /etc/shadow
# directly via python to avoid shell-quoting the $-delimited crypt hash.
if [ -n "${ASTROMESH_BREAKGLASS_HASH:-}" ]; then
    python3 - "${ROOT}/etc/shadow" "${ASTROMESH_BREAKGLASS_HASH}" <<'PY'
import sys
path, h = sys.argv[1], sys.argv[2]
with open(path) as fh:
    lines = fh.read().splitlines()
found = False
for i, ln in enumerate(lines):
    f = ln.split(':')
    if f and f[0] == 'root':
        f[1] = h
        lines[i] = ':'.join(f)
        found = True
        break
if not found:
    sys.exit("[finalize] FAIL: no root entry in /etc/shadow; cannot set break-glass hash")
with open(path, 'w') as fh:
    fh.write('\n'.join(lines) + '\n')
PY
    echo "[finalize] break-glass: provisioned root hash set"
else
    echo "[finalize] break-glass: no hash provided; root stays locked (disabled)"
fi
