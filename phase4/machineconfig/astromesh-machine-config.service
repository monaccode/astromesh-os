[Unit]
Description=Astromesh OS Fase 4.1 machine-config (declarative profile + identity, no SSH)
# Runs BEFORE astromeshd. Provisioned via SMBIOS type 11:
#   io.systemd.credential.binary:astromesh.machine_config=<base64 YAML>
# Absent credential -> no-op (the astromeshd launcher falls back to baked /etc/astromesh).
Before=astromeshd.service

[Service]
Type=oneshot
ImportCredential=astromesh.machine_config
ExecStart=/usr/lib/astromesh-os/astromesh-machine-config.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
