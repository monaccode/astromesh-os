[Unit]
Description=Astromesh OS Fase 4.4b eBPF egress -> OTLP metric export
After=egress-acct.service otel-collector.service
Wants=egress-acct.service otel-collector.service

[Service]
Type=oneshot
ExecStart=/opt/astromesh/venv/bin/python3 /usr/lib/astromesh-os/ebpf/egress-otlp-export.py
StandardOutput=journal+console
StandardError=journal+console
