[Unit]
Description=Astromesh OS Fase 4.4 eBPF per-flow egress accounting (cgroup_skb/egress)
After=astromeshd.service
Wants=astromeshd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/ebpf/egress-acct.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
