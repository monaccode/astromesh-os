[Unit]
Description=Astromesh OS Fase 4.2 static mesh IP on the socket-netdev NIC
After=systemd-networkd.service astromesh-machine-config.service
Before=mesh-ipsec.service

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/mesh/mesh-net.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
