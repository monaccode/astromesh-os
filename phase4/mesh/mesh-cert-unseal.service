[Unit]
Description=Astromesh OS Fase 4.2 mesh node-key unseal (each boot)
After=mesh-cert-issue.service systemd-pcrphase.service
Before=mesh-ipsec.service astromeshd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/mesh/mesh-cert-unseal.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
