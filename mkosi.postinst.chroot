#!/usr/bin/env bash
# Runs INSIDE the image chroot (the .chroot suffix selects in-image execution).
# Reads build inputs (the .deb, stub payload, agent templates) from the mkosi
# source tree, which mkosi bind-mounts and exposes via $SRCDIR.
set -euo pipefail

MODE="${PHASE0_MODE:-stub}"
ETC="/etc/astromesh"
SRC="${SRCDIR:-/work/src}"
echo "[postinst] PHASE0_MODE=${MODE}; SRC=${SRC}"

# 1. Install the astromesh-node .deb (CI leaves it under ./dist of the source tree).
DEB=$(ls "${SRC}"/dist/astromesh-node_*_amd64.deb 2>/dev/null | head -1 || true)
if [ -z "${DEB}" ]; then
    echo "[postinst] ERROR: astromesh-node .deb not found under ${SRC}/dist"
    exit 1
fi
echo "[postinst] Installing ${DEB}"
# The minimal image ships dpkg but not apt; the .deb's deps (python3, python3-venv)
# are already installed via mkosi Packages=, so dpkg -i resolves cleanly.
# Neutralize systemctl during the .deb maintainer scripts: there is no running
# systemd in the build chroot, so `systemctl daemon-reload` would hit the bus and
# fail. dpkg runs maintainer scripts with PATH=/usr/sbin:/usr/bin:/sbin:/bin, so we
# replace the real binary directly, then restore it. Our own (offline, filesystem-
# only) `systemctl enable` calls run afterward against the restored binary.
SYSCTL=/usr/bin/systemctl
if [ -e "${SYSCTL}" ]; then mv "${SYSCTL}" "${SYSCTL}.real"; fi
printf '#!/bin/sh\nexit 0\n' > "${SYSCTL}"
chmod +x "${SYSCTL}"
dpkg -i "${DEB}"
if [ -e "${SYSCTL}.real" ]; then mv -f "${SYSCTL}.real" "${SYSCTL}"; fi

# 1b. The .deb's venv was created at a build-time staging path and relocated to
#     /opt/astromesh/venv, so its console-script shebangs point at a path that does
#     not exist in the image (astromeshd then fails with 203/EXEC). Rewrite the
#     python shebangs to the installed venv interpreter.
echo "[postinst] venv bin before fix:"; ls -la /opt/astromesh/venv/bin 2>&1 | head -20 || true
echo "[postinst] astromeshd shebang:"; head -1 /opt/astromesh/venv/bin/astromeshd 2>&1 || true
if [ -d /opt/astromesh/venv/bin ]; then
    for s in /opt/astromesh/venv/bin/*; do
        [ -f "${s}" ] || continue
        first=$(head -1 "${s}" 2>/dev/null || true)
        case "${first}" in
            "#!"*python*) sed -i "1s|^#!.*|#!/opt/astromesh/venv/bin/python3|" "${s}" ;;
        esac
    done
fi
echo "[postinst] astromeshd shebang after fix:"; head -1 /opt/astromesh/venv/bin/astromeshd 2>&1 || true

# 1c. Trim the venv to help fit the size budget (spec §4.2): bytecode caches and
#     in-package test dirs. Only safe-to-remove artefacts; the boot-to-agent gate
#     guards against removing anything the runtime needs.
echo "[postinst] stripping venv caches/tests"
find /opt/astromesh/venv -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
find /opt/astromesh/venv -type f -name '*.pyc' -delete 2>/dev/null || true
find /opt/astromesh/venv -type d \( -name tests -o -name test \) \
    -path '*/site-packages/*' -prune -exec rm -rf {} + 2>/dev/null || true

# 2. Install the smoke agent variant for this mode into the auto-loaded agents dir.
#    The runtime reads model.primary.endpoint (NOT providers.yaml), so the endpoint
#    lives in the agent YAML itself.
if [ "${MODE}" = "real" ]; then
    install -m 0640 "${SRC}/phase0/agents/phase0-smoke.real.yaml" "${ETC}/agents/phase0-smoke.agent.yaml"
else
    install -m 0640 "${SRC}/phase0/agents/phase0-smoke.stub.yaml" "${ETC}/agents/phase0-smoke.agent.yaml"
fi
chown root:astromesh "${ETC}/agents/phase0-smoke.agent.yaml"

# 3. Provider API key for astromeshd.service. When sealing (Fase 3.3, ASTROMESH_SEAL_SECRET=1)
#    the key is NOT baked — it is provisioned at first boot and TPM-sealed (see the seal/unseal
#    services below), so the image ships no plaintext key. Otherwise (Fase 0/2 builds) bake the
#    dummy/real key as before so those gates keep a working key.
install -m 0640 /dev/null "${ETC}/.env"
chown root:astromesh "${ETC}/.env"
if [ "${ASTROMESH_SEAL_SECRET:-0}" = "1" ]; then
    echo "[postinst] ASTROMESH_SEAL_SECRET=1 → provider key not baked (TPM-sealed at first boot)"
else
    echo "OPENAI_API_KEY=${OPENAI_API_KEY:-sk-phase0-stub-dummy}" > "${ETC}/.env"
    chmod 0640 "${ETC}/.env"; chown root:astromesh "${ETC}/.env"
fi

# 4. Stub OpenAI server + service, only in stub mode. The stub runs with the runtime
#    venv's python (which already bundles fastapi/uvicorn), so no extra packages are
#    installed here (mkosi runs this script without network anyway).
if [ "${MODE}" = "stub" ]; then
    echo "[postinst] Installing Phase 0 stub"
    install -d /opt/phase0-stub
    install -m 0644 "${SRC}/tests/stub-openai/stub_server.py" /opt/phase0-stub/stub_server.py
    install -m 0644 "${SRC}/tests/stub-openai/phase0-stub.service" /etc/systemd/system/phase0-stub.service
    systemctl enable phase0-stub.service
fi

# 5. Bring up the NIC with DHCP so the host can reach the API (QEMU user-net
#    assigns 10.0.2.15 via DHCP; without this the hostfwd never connects).
install -d /etc/systemd/network
cat > /etc/systemd/network/20-wired.network <<'NET'
[Match]
Name=en* eth*

[Network]
DHCP=yes
NET
systemctl enable systemd-networkd.service

# 6. Drop the systemd watchdog for astromeshd. The unit ships WatchdogSec=30 but the
#    daemon only sends READY=1 (no periodic WATCHDOG=1), so systemd kills it every
#    30s. Phase 0 only needs it to stay up and answer one query.
install -d /etc/systemd/system/astromeshd.service.d
cat > /etc/systemd/system/astromeshd.service.d/10-no-watchdog.conf <<'WD'
[Service]
WatchdogSec=0
WD

# 7. Ensure astromeshd is enabled (the .deb already does this; idempotent).
systemctl enable astromeshd.service


# 8. Boot-to-agent target: make astromeshd the purpose of the system. getty is
#    intentionally kept (no-shell is Fase 3). The target's own `Requires=astromeshd`
#    is what starts the daemon (an [Install] WantedBy in a drop-in is ignored by
#    systemctl enable), so no service drop-in is needed.
install -m 0644 "${SRC}/phase1/astromesh-os.target" /usr/lib/systemd/system/astromesh-os.target
systemctl set-default astromesh-os.target


# 9. Immutability (Fase 2a): /var is a baked writable partition (mkosi.repart with
#    MountPoint=/var); tmpfiles recreates the runtime dirs on the fresh /var (which
#    shadows the dirs baked into the read-only root).
install -m 0644 "${SRC}/phase2/tmpfiles/astromesh-var.conf" /usr/lib/tmpfiles.d/astromesh-var.conf
install -d /usr/lib/astromesh-os

# Fase 2b: bake the image version and a console version marker for the A/B test.
echo "${IMAGE_VERSION:-1}" > /usr/lib/astromesh-os/build-version
install -m 0755 "${SRC}/phase2b/version-marker.sh" /usr/lib/astromesh-os/version-marker.sh
install -m 0644 "${SRC}/phase2b/version-marker.service" /etc/systemd/system/version-marker.service
systemctl enable version-marker.service

# Fase 2b: custom A/B updater.
install -m 0755 "${SRC}/phase2b/astromesh-update.sh" /usr/lib/astromesh-os/astromesh-update.sh
install -m 0644 "${SRC}/phase2b/astromesh-update.service" /etc/systemd/system/astromesh-update.service
systemctl enable astromesh-update.service

# Fase 2b-rollback: health-gated boot assessment.
install -m 0755 "${SRC}/phase2b/astromesh-boot-check.sh" /usr/lib/astromesh-os/astromesh-boot-check.sh
install -m 0644 "${SRC}/phase2b/astromesh-boot-check.service" /etc/systemd/system/astromesh-boot-check.service
systemctl enable astromesh-boot-check.service
# The stock systemd-bless-boot.service marks the booted entry good UNCONDITIONALLY when
# boot-complete.target is reached — which a booted-but-unhealthy slot also reaches. Mask
# it so blessing happens ONLY via astromesh-boot-check (on health). systemd-boot still
# decrements the +tries counter on its own; only the "mark good" is ours.
systemctl mask systemd-bless-boot.service

install -m 0755 "${SRC}/phase2/immutability-check.sh" /usr/lib/astromesh-os/immutability-check.sh
install -m 0644 "${SRC}/phase2/immutability-check.service" /etc/systemd/system/immutability-check.service
systemctl enable immutability-check.service

# Test-only: ASTROMESH_BREAK_HEALTH=1 makes this build deliberately UNHEALTHY to exercise
# the A/B rollback gate. The slot must still BOOT to the default target: astromesh-os.target
# has Requires=astromeshd.service, so MASKING astromeshd would make the target un-isolable
# ("Failed to isolate default target") — a boot *failure*, during which the health-gated
# boot-check never runs and nothing ever rolls back. Instead keep astromeshd ACTIVE but
# serving nothing on :8000: a Type=exec `sleep` counts as active the instant it execs (no
# READY=1 needed, unlike the real Type=notify daemon), so the target isolates and the
# system reaches multi-user.target and runs astromesh-boot-check, while /v1/health stays
# dead → boot-check times out → reboot → tries exhaust → rollback. Never set in normal builds.
if [ "${ASTROMESH_BREAK_HEALTH:-0}" = "1" ]; then
    echo "[postinst] ASTROMESH_BREAK_HEALTH=1 → astromeshd active but health-dead (rollback gate)"
    install -d /etc/systemd/system/astromeshd.service.d
    # AppArmorProfile= (empty) resets the Fase 3.2 confinement (20-apparmor.conf, applied
    # earlier lexically) for this test-only stub: the astromeshd profile only permits the
    # venv python3, so it would deny exec of /usr/bin/sleep and the stub would fail to start
    # — collapsing the target isolation the rollback gate depends on. The broken-v2 is a test
    # artifact, so running its stub unconfined is fine.
    cat > /etc/systemd/system/astromeshd.service.d/99-break-health.conf <<'BRK'
[Service]
Type=exec
ExecStart=
ExecStart=/usr/bin/sleep infinity
Restart=no
AppArmorProfile=
BRK
fi

# Fase 3.1: no-shell. Mask every interactive console login path so a normal boot to
# astromesh-os.target presents no usable shell. Mask the getty templates (masking a
# template masks all instances) AND getty.target (multi-user.target Wants it; masked => the
# want is skipped). Masking is a filesystem op (symlink to /dev/null), so it works in this
# offline build chroot.
systemctl mask serial-getty@.service getty@.service console-getty.service autovt@.service getty.target

# Fase 3.1: break-glass credential is set in mkosi.finalize, NOT here. mkosi applies
# RootPassword=hashed:! (mkosi.conf) AFTER postinst, which would clobber a hash set here
# (verified: slot shadow came out as '!'). finalize runs last, so the hash sticks there.

# Fase 3.1: hardening self-check (no-shell posture marker).
install -m 0755 "${SRC}/phase3/astromesh-hardening-check.sh" /usr/lib/astromesh-os/astromesh-hardening-check.sh
install -m 0644 "${SRC}/phase3/astromesh-hardening-check.service" /etc/systemd/system/astromesh-hardening-check.service
systemctl enable astromesh-hardening-check.service

# Fase 3.2: AppArmor confinement for astromeshd.
install -d /etc/apparmor.d
install -m 0644 "${SRC}/phase3/apparmor/astromeshd" /etc/apparmor.d/astromeshd
install -d /etc/systemd/system/astromeshd.service.d
install -m 0644 "${SRC}/phase3/apparmor/20-apparmor.conf" /etc/systemd/system/astromeshd.service.d/20-apparmor.conf
# apparmor.service loads /etc/apparmor.d/* into the kernel at boot.
systemctl enable apparmor.service
# In-guest confinement self-check (asserts confined+no-denials+positive-block at boot).
install -m 0755 "${SRC}/phase3/apparmor/confine-check.sh" /usr/lib/astromesh-os/confine-check.sh
install -m 0644 "${SRC}/phase3/apparmor/confine-check.service" /etc/systemd/system/confine-check.service
systemctl enable confine-check.service

# Fase 3.3: TPM-sealed provider key (seal at first boot, unseal each boot to a tmpfs env).
# Installed unconditionally; harmless no-ops when no TPM/credential/blob is present (Fase 0/2).
install -m 0755 "${SRC}/phase3/tpm/astromesh-seal-secret.sh" /usr/lib/astromesh-os/astromesh-seal-secret.sh
install -m 0755 "${SRC}/phase3/tpm/astromesh-unseal-secret.sh" /usr/lib/astromesh-os/astromesh-unseal-secret.sh
install -m 0644 "${SRC}/phase3/tpm/astromesh-seal-secret.service" /etc/systemd/system/astromesh-seal-secret.service
install -m 0644 "${SRC}/phase3/tpm/astromesh-unseal-secret.service" /etc/systemd/system/astromesh-unseal-secret.service
install -d /etc/systemd/system/astromeshd.service.d
install -m 0644 "${SRC}/phase3/tpm/10-sealed-env.conf" /etc/systemd/system/astromeshd.service.d/10-sealed-env.conf
systemctl enable astromesh-seal-secret.service astromesh-unseal-secret.service

# Fase 3.4: E-MVP sandbox. Harden astromeshd at the syscall+namespace+privilege level and
# install the fail-closed self-check. Additive to the 3.2 AppArmor profile and 3.3 unseal.
install -d /etc/systemd/system/astromeshd.service.d
install -m 0644 "${SRC}/phase3/sandbox/30-sandbox.conf" /etc/systemd/system/astromeshd.service.d/30-sandbox.conf
install -m 0755 "${SRC}/phase3/sandbox/astromesh-sandbox-check.sh" /usr/lib/astromesh-os/astromesh-sandbox-check.sh
install -m 0644 "${SRC}/phase3/sandbox/astromesh-sandbox-check.service" /etc/systemd/system/astromesh-sandbox-check.service
systemctl enable astromesh-sandbox-check.service

echo "[postinst] done (mode=${MODE})"
