# This repo builds a Linux OS image. Every tracked text file is consumed on Linux
# (in the mkosi build, inside the image, or by CI on ubuntu runners). CRLF in a
# shell script makes bash read `pipefail\r` as an invalid option and aborts; CRLF
# in a systemd unit or mkosi config is equally fatal. Force LF in the working tree
# everywhere so a Windows checkout (core.autocrlf=true) cannot corrupt the build.
* text=auto eol=lf

# Be explicit for the executable/config files that MUST be LF to run.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
mkosi.*     text eol=lf

# Binaries must never be touched.
*.raw       binary
*.efi       binary
*.fd        binary
*.qcow2     binary
*.img       binary
*.png       binary
