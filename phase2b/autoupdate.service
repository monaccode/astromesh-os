[Unit]
Description=Astromesh OS A/B auto-update
# Only order after the network; depending on other multi-user.target-wanted units
# (astromeshd, version-marker, which is After=multi-user.target) creates an
# ordering cycle and systemd skips this service.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/autoupdate.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
