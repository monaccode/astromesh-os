[Unit]
Description=Astromesh OS Fase 3.1 hardening self-check (no-shell posture)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/astromesh-hardening-check.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
