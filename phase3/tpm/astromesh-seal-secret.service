[Unit]
Description=Astromesh OS Fase 3.3 seal provider key to TPM (first boot)
After=multi-user.target
Before=astromesh-unseal-secret.service

[Service]
Type=oneshot
# Provisioned via SMBIOS type 11: io.systemd.credential:astromesh.openai_key=<key>
ImportCredential=astromesh.openai_key
ExecStart=/usr/lib/astromesh-os/astromesh-seal-secret.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
