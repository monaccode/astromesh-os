[Unit]
Description=Astromesh OS Fase 3.3 seal provider key to TPM (first boot)
# Order after TPM SRK setup AND after systemd-pcrphase.service — the latter extends PCR 11 with
# the 'ready' boot phase, which is the LAST PCR 11 extension of a normal boot. Running after it
# makes PCR 11 deterministically stable, so the value sealed here matches the value the unseal
# service reads (otherwise they race the phase barrier and the intact-boot unseal fails).
# NOT After=multi-user.target: combined with Before=astromeshd (a multi-user service) that would
# form an ordering cycle and systemd would cycle-break/skip the unit.
After=systemd-tpm2-setup.service tpm2.target systemd-pcrphase.service
Before=astromesh-unseal-secret.service astromeshd.service

[Service]
Type=oneshot
# Provisioned via SMBIOS type 11: io.systemd.credential:astromesh.openai_key=<key>
ImportCredential=astromesh.openai_key
ExecStart=/usr/lib/astromesh-os/astromesh-seal-secret.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
