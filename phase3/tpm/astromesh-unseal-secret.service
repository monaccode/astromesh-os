[Unit]
Description=Astromesh OS Fase 3.3 unseal provider key from TPM (every boot)
After=multi-user.target astromesh-seal-secret.service
Before=astromeshd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/astromesh-unseal-secret.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
