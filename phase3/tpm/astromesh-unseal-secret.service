[Unit]
Description=Astromesh OS Fase 3.3 unseal provider key from TPM (every boot)
# See seal-secret.service: ordered after systemd-pcrphase.service so PCR 11 is stable (same value
# the seal bound to). NOT After=multi-user.target (would cycle with Before=astromeshd).
After=astromesh-seal-secret.service systemd-tpm2-setup.service tpm2.target systemd-pcrphase.service
Before=astromeshd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/astromesh-unseal-secret.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
