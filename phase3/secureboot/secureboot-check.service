[Unit]
Description=Astromesh OS Fase 3.6 Secure Boot self-check
After=multi-user.target
DefaultDependencies=yes

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/secureboot-check.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
