[Unit]
Description=Astromesh OS Fase 3.2 AppArmor confinement self-check
# Run after the daemon it inspects is up.
After=multi-user.target astromeshd.service
Wants=astromeshd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/astromesh-os/confine-check.sh
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
