# AppArmor profile for the Astromesh agent runtime daemon (Fase 3.2).
# Named profile, attached to astromeshd.service via AppArmorProfile=astromeshd (systemd
# drop-in). Deny-by-default, ENFORCE. The complain-mode dev pass showed zero denials over
# the daemon's startup + health + agent-query paths, so the initial allow-set below is
# already complete; no extra rules were needed.
#include <tunables/global>

profile astromeshd {
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>

  # The venv interpreter (read + execute, inherit this profile) and its tree.
  /opt/astromesh/venv/bin/python3* mrix,
  /opt/astromesh/venv/** r,
  /opt/astromesh/venv/**.so* mr,

  # Config (read-only): agents, .env, providers.
  /etc/astromesh/{,**} r,

  # Writable state — the ONLY writable paths.
  /var/lib/astromesh/{,**} rwk,
  /var/log/astromesh/{,**} rwk,

  # Network: bind :8000 and egress to the provider. TCP only; DNS (UDP) resolution is
  # covered by abstractions/nameservice above — do not drop that include or egress breaks.
  network inet stream,
  network inet6 stream,
  # Resolver: /etc/resolv.conf is a symlink to /run/resolv.conf, which astromesh-resolv.service
  # renders from the DHCP lease (nameservice only whitelists NetworkManager/connman/netconfig/
  # systemd paths, not this one). Without this read the daemon can't resolve provider hostnames.
  /run/resolv.conf r,

  # Common runtime reads (extend from the complain-mode denials in Task 6, do not pre-allow blindly).
  /proc/sys/kernel/random/uuid r,
  @{PROC}/@{pid}/stat r,
  owner @{PROC}/@{pid}/fd/ r,
}
